[app]
title = Quantarion AI
package.name = quantarionai
package.domain = org.quantarion
source.dir = /Quantarion_AI
source.include_exts = py,html,css,js,json,png,jpg
version = 1.0.0
requirements = python3,fastapi,uvicorn,pydantic
orientation = portrait
fullscreen = 1
android.archs = arm64-v8a
android.allow_backup = False
android.permissions = INTERNET

[buildozer]
log_level = 1
warn_on_root = 0
